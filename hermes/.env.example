# Set these in the live Hermes profile that handles the WhatsApp number.
PARENT_HEALTH_API_BASE_URL=https://parent-health-api.onrender.com
PARENT_HEALTH_API_TIMEOUT_SECONDS=40

# Restrict WhatsApp to explicitly approved consenting numbers.
# Example: WHATSAPP_ALLOWED_USERS=919876543210,919876500000
# Never use * and never enable an open-allowlist override.
WHATSAPP_ALLOWED_USERS=
