# --- Backend (apps/api / Render) ---
# Use Supabase's Session pooler connection string in production.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/parent_health_agent
CORS_ORIGINS=http://localhost:3000
WHATSAPP_INVITE_BASE_URL=http://localhost:3000/join

# Optional: disabled by default so signup never waits for a local/unstable bridge.
WHATSAPP_GROUP_CREATION_ENABLED=false
WHATSAPP_BRIDGE_BASE_URL=
WHATSAPP_GROUP_NAME_TEMPLATE={parent_name}'s Care Circle
WHATSAPP_GROUP_TIMEOUT_SECONDS=10

# Conservative defaults for one small API instance behind Supabase's pooler.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300

# --- Frontend (apps/web / Vercel) ---
# Preferred server-only backend URL used by Next.js API routes.
API_BASE_URL=http://localhost:8000

# Legacy fallback only. Browser code no longer calls this URL directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
