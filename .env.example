# --- Backend (apps/api / Render) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/parent_health_agent
CORS_ORIGINS=http://localhost:3000
WHATSAPP_INVITE_BASE_URL=http://localhost:3000/join
WHATSAPP_SIGNUP_URL=http://localhost:3000

# --- Hosted WhatsApp onboarding (Meta WhatsApp Cloud API) ---
# Leave WHATSAPP_PROVIDER unset (or "none") to keep hosted onboarding fully
# disabled — safe default for local dev and tests. Set it to "meta" only once
# every value below is filled in; the app fails fast with a clear error if
# WHATSAPP_PROVIDER=meta is set without all of them.
WHATSAPP_PROVIDER=none
WHATSAPP_META_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_META_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_META_APP_SECRET=your-meta-app-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-random-verification-string
WHATSAPP_META_GRAPH_API_VERSION=v21.0

# --- Frontend (apps/web / Vercel) ---
# The current landing-page client uses NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only URL used by Next.js API routes such as /api/whatsapp/join.
# In production this can use the same Render API URL.
API_BASE_URL=http://localhost:8000
